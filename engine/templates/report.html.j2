<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#14110F;--muted:#6B645C;--line:#E6E0D8;--paper:#FBF8F4;--card:#fff;--accent:#C2410C;--hi:#B91C1C;--fo:#B45309;--re:#475569;--ok:#15803D}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 Inter,"IBM Plex Sans Arabic",system-ui,-apple-system,"Segoe UI",sans-serif}
.wrap{max-width:860px;margin:0 auto;padding:28px 18px 60px}
header{border-bottom:3px solid var(--ink);padding-bottom:16px;margin-bottom:22px}
.kicker{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600}
h1{font-family:Fraunces,Georgia,serif;font-size:34px;line-height:1.1;margin:6px 0 4px}
.meta{color:var(--muted);font-size:13px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:18px 0 6px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.stat b{display:block;font-size:22px;font-family:Fraunces,Georgia,serif}
.stat span{font-size:12px;color:var(--muted)}
.exec{background:var(--card);border-left:4px solid var(--accent);padding:14px 16px;border-radius:0 10px 10px 0;margin:18px 0}
.exec li{margin:4px 0}
h2{font-family:Fraunces,Georgia,serif;font-size:22px;margin:34px 0 12px;padding-top:10px;border-top:1px solid var(--line)}
h2 small{font-family:Inter,sans-serif;font-size:12px;color:var(--muted);font-weight:500;margin-left:6px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin:0 0 14px;page-break-inside:avoid;break-inside:avoid}
.card .img{width:100%;height:200px;object-fit:cover;display:block;background:#EFE9E1}
.card .body{padding:14px 16px 16px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.tag{font-size:11px;padding:2px 8px;border-radius:99px;background:#F3EEE7;color:var(--muted)}
.p-High{background:#FEE2E2;color:var(--hi);font-weight:600}.p-Worth{background:#FEF3C7;color:var(--fo);font-weight:600}
.p-Research{background:#E2E8F0;color:var(--re)}
.card h3{font-size:18px;line-height:1.3;margin:4px 0 6px;font-family:Fraunces,Georgia,serif;font-weight:600}
.card h3 a{color:inherit;text-decoration:none}
.src{font-size:12.5px;color:var(--muted);margin-bottom:8px}
.row{margin:7px 0;font-size:14px}.row b{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);display:block}
.data{font-size:13px;background:#FFF7ED;border-radius:8px;padding:8px 10px;margin:8px 0}
.link{display:inline-block;margin-top:8px;font-size:13px;font-weight:600;color:var(--accent);word-break:break-all}
.score{float:right;font-family:Fraunces,Georgia,serif;font-size:20px;color:var(--ink)}
.compact li{margin:6px 0}
table{width:100%;border-collapse:collapse;font-size:13px;background:var(--card)}td,th{border:1px solid var(--line);padding:6px 8px;text-align:left}
.refs{font-size:12px;color:var(--muted);word-break:break-all}
footer{margin-top:40px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:12px}
[dir=auto]{unicode-bidi:plaintext}
@media print{body{background:#fff}.wrap{max-width:none;padding:0 10mm}.card .img{height:160px}}
@media (max-width:520px){h1{font-size:27px}.card .img{height:170px}}
</style>
</head>
<body><div class="wrap">
<header>
  <div class="kicker">{{ kicker }}</div>
  <h1>{{ title }}</h1>
  <div class="meta">{{ period }} · Generated {{ generated }} (Cairo) · Mohamed Sherif · Brand Intelligence</div>
  <div class="stats">{% for s in stats %}<div class="stat"><b>{{ s[1] }}</b><span>{{ s[0] }}</span></div>{% endfor %}</div>
</header>

<div class="exec"><b>Executive summary</b><ul>{% for e in executive %}<li dir="auto">{{ e }}</li>{% endfor %}</ul></div>

{% macro card(n, img=True) -%}
<article class="card">
  {% if img and n.image_url %}<img class="img" src="{{ n.image_url }}" alt="" loading="lazy" onerror="this.remove()">{% endif %}
  <div class="body">
    <span class="score">{{ n.overall_score }}</span>
    <div class="tags"><span class="tag p-{{ n.priority.split(' ')[0] }}">{{ n.priority }}</span><span class="tag">{{ n.news_type }}</span>{% for g in n.geography[:2] %}<span class="tag">{{ g }}</span>{% endfor %}</div>
    <h3 dir="auto"><a href="{{ n.url }}">{{ n.headline }}</a></h3>
    <div class="src">{{ n.source_name }} · Published {{ n.pub_display }}{% if n.date_status != 'fresh' %} · <i>{{ n.date_status }}</i>{% endif %}</div>
    <div class="row" dir="auto"><b>Summary</b>{{ n.short_summary }}</div>
    <div class="row"><b>Why it matters</b>{{ n.why_it_matters | replace('[AI-generated interpretation · rule template] ','') | replace('[AI-generated interpretation] ','') }}</div>
    {% if n.financial_data %}<div class="data"><b>Important data</b> (publisher claims){% for f in n.financial_data[:4] %}<br>• {{ f.value }} — {{ f.metric }} <i>({{ f.status }})</i>{% endfor %}</div>{% endif %}
    {% if n.strategic_insights %}<div class="row"><b>Strategic implication</b>{{ n.strategic_insights | replace('[AI-generated interpretation] ','') }}</div>{% endif %}
    {% if n.content_angle %}<div class="row"><b>Content angle</b>{{ n.content_angle }}</div>{% endif %}
    <a class="link" href="{{ n.url }}">Read original ↗</a>
  </div>
</article>
{%- endmacro %}

{% for sec in sections %}
<h2>{{ sec.title }} <small>{{ sec.stories|length }}</small></h2>
{% if sec.note %}<p class="meta">{{ sec.note }}</p>{% endif %}
{% if not sec.stories %}<p class="meta">Nothing significant in this period.</p>{% endif %}
{% for n in sec.stories %}{{ card(n, sec.images) }}{% endfor %}
{% endfor %}

{% for t in tables %}
<h2>{{ t.title }}</h2>
<table><tr>{% for h in t.head %}<th>{{ h }}</th>{% endfor %}</tr>{% for r in t.rows %}<tr>{% for c in r %}<td dir="auto">{{ c }}</td>{% endfor %}</tr>{% endfor %}</table>
{% endfor %}

{% if opportunities %}<h2>Content opportunities</h2><ul class="compact">{% for o in opportunities %}<li dir="auto"><b>{{ o.angle }}</b> — <a href="{{ o.url }}">{{ o.headline }}</a></li>{% endfor %}</ul>{% endif %}

<h2>Source references</h2>
<ol class="refs">{% for n in refs %}<li dir="auto">{{ n.source_name }} — <a href="{{ n.url }}">{{ n.url }}</a></li>{% endfor %}</ol>

<footer>Summaries are short excerpts or paraphrases with links to the originals; read the source before publishing. Labels: figures = publisher claims unless marked verified; "why it matters" & implications = AI-generated interpretation. Scores: relevance 20 · impact 20 · innovation 15 · credibility 15 · evidence 15 · content 10 · regional 5.</footer>
</div></body></html>
