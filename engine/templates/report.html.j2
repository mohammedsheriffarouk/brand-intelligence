<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#14110F;--muted:#6B645C;--line:#E6E0D8;--paper:#FBF8F4;--card:#fff;--accent:#C2410C;--hi:#B91C1C;--fo:#B45309;--re:#475569}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.75 "IBM Plex Sans Arabic",Inter,system-ui,sans-serif}
.wrap{max-width:860px;margin:0 auto;padding:28px 18px 60px}
header{border-bottom:3px solid var(--ink);padding-bottom:16px;margin-bottom:22px}
.kicker{font-size:13px;color:var(--accent);font-weight:700}
h1{font-size:32px;line-height:1.3;margin:6px 0 4px;font-weight:700}
.meta{color:var(--muted);font-size:13px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:18px 0 6px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.stat b{display:block;font-size:24px}
.stat span{font-size:12px;color:var(--muted)}
.exec{background:var(--card);border-right:4px solid var(--accent);padding:14px 16px;border-radius:10px 0 0 10px;margin:18px 0}
.exec li{margin:4px 0}
h2{font-size:22px;margin:34px 0 12px;padding-top:10px;border-top:1px solid var(--line)}
h2 small{font-size:12px;color:var(--muted);font-weight:500;margin-right:6px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin:0 0 14px;page-break-inside:avoid;break-inside:avoid}
.card .img{width:100%;height:210px;object-fit:cover;display:block;background:#EFE9E1}
.card .body{padding:14px 16px 16px}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.tag{font-size:11.5px;padding:1px 9px;border-radius:99px;background:#F3EEE7;color:var(--muted)}
.p-High{background:#FEE2E2;color:var(--hi);font-weight:700}.p-Worth{background:#FEF3C7;color:var(--fo);font-weight:700}.p-Research{background:#E2E8F0;color:var(--re)}
.card h3{font-size:19px;line-height:1.5;margin:4px 0 2px;font-weight:700}
.card h3 a{color:inherit;text-decoration:none}
.en{font:13px/1.45 Inter,sans-serif;color:var(--muted);direction:ltr;text-align:left;margin-bottom:8px}
.src{font-size:12.5px;color:var(--muted);margin-bottom:8px}
.row{margin:8px 0;font-size:15px}.row b{font-size:12px;color:var(--accent);display:block}
.data{font-size:13.5px;background:#FFF7ED;border-radius:8px;padding:8px 10px;margin:8px 0}
.link{display:inline-block;margin-top:8px;font-size:13.5px;font-weight:700;color:var(--accent)}
.url{display:block;font:11.5px Inter,sans-serif;color:var(--muted);direction:ltr;text-align:left;word-break:break-all;margin-top:2px}
.score{float:left;font:700 20px Inter,sans-serif}
.compact li{margin:6px 0}
table{width:100%;border-collapse:collapse;font-size:13.5px;background:var(--card)}td,th{border:1px solid var(--line);padding:6px 8px;text-align:right}
.refs{font-size:12px;color:var(--muted)}.refs a{direction:ltr;unicode-bidi:embed;word-break:break-all}
footer{margin-top:40px;font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:12px}
@media print{body{background:#fff}.wrap{max-width:none;padding:0 10mm}.card .img{height:170px}}
@media (max-width:520px){h1{font-size:26px}.card .img{height:180px}}
</style>
</head>
<body><div class="wrap">
<header>
  <div class="kicker">{{ kicker }}</div>
  <h1>{{ title }}</h1>
  <div class="meta">{{ period }} · اتعمل {{ generated }} (بتوقيت القاهرة)</div>
  <div class="stats">{% for s in stats %}<div class="stat"><b>{{ s[1] }}</b><span>{{ s[0] }}</span></div>{% endfor %}</div>
</header>

<div class="exec"><b>الملخص التنفيذي</b><ul>{% for e in executive %}<li>{{ e }}</li>{% endfor %}</ul></div>

{% macro card(n, img=True) -%}
<article class="card">
  {% if img and n.image_url %}<img class="img" src="{{ n.image_url }}" alt="" loading="lazy" onerror="this.remove()">{% endif %}
  <div class="body">
    <span class="score">{{ n.overall_score }}</span>
    <div class="tags"><span class="tag p-{{ n.priority.split(' ')[0] }}">{{ ar.priority.get(n.priority, n.priority) }}</span><span class="tag">{{ ar.type.get(n.news_type[:3], n.news_type) }}</span>{% for g in n.geography[:2] %}<span class="tag">{{ ar.geo.get(g, g) }}</span>{% endfor %}</div>
    <h3><a href="{{ n.url }}">{{ n.headline_ar or n.headline }}</a></h3>
    {% if n.headline_ar %}<div class="en">{{ n.headline }}</div>{% endif %}
    <div class="src">{{ n.source_name }} · نُشر {{ n.pub_display }}{% if n.date_status != 'fresh' %} · <i>{{ ar.date.get(n.date_status, n.date_status) }}</i>{% endif %}</div>
    {% if n.summary_ar %}<div class="row"><b>الملخص</b>{{ n.summary_ar }}</div>
    {% elif n.short_summary and not n.short_summary.startswith('No summary') %}<div class="row"><b>الملخص (من الناشر)</b><span class="en" style="display:block">{{ n.short_summary }}</span></div>
    {% else %}<div class="row"><b>الملخص</b>المصدر مانشرش ملخص. افتح الخبر الأصلي للتفاصيل.</div>{% endif %}
    <div class="row"><b>ليه مهم</b>{{ n.why_ar }}</div>
    {% if n.financial_data %}<div class="data"><b>أرقام مذكورة</b> (ادعاءات الناشر، مش متأكَّد منها){% for f in n.financial_data[:4] %}<br>• <span dir="ltr">{{ f.value }}</span>: {{ f.metric }}{% endfor %}</div>{% endif %}
    <div class="row"><b>زاوية محتوى</b>{{ n.angle_ar }}</div>
    <a class="link" href="{{ n.url }}">اقرأ الخبر الأصلي ↗</a>
    <span class="url">{{ n.url[:110] }}</span>
  </div>
</article>
{%- endmacro %}

{% for sec in sections %}
<h2>{{ ar.section.get(sec.title, sec.title) }} <small>{{ sec.stories|length }}</small></h2>
{% if sec.note %}<p class="meta">{{ sec.note }}</p>{% endif %}
{% if not sec.stories %}<p class="meta">مافيش أخبار مهمة في الفترة دي.</p>{% endif %}
{% for n in sec.stories %}{{ card(n, sec.images) }}{% endfor %}
{% endfor %}

{% for t in tables %}
<h2>{{ t.title }}</h2>
<table><tr>{% for h in t.head %}<th>{{ h }}</th>{% endfor %}</tr>{% for r in t.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</table>
{% endfor %}

{% if opportunities %}<h2>فرص محتوى</h2><ul class="compact">{% for o in opportunities %}<li><b>{{ o.angle }}</b>: <a href="{{ o.url }}">{{ o.headline }}</a></li>{% endfor %}</ul>{% endif %}

<h2>المصادر</h2>
<ol class="refs">{% for n in refs %}<li>{{ n.source_name }}: <a href="{{ n.url }}">{{ n.url[:100] }}</a></li>{% endfor %}</ol>

<footer>الملخصات مختصرة أو مترجمة ومعاها لينك للمصدر الأصلي، فارجع للمصدر قبل ما تنشر. الأرقام ادعاءات من الناشر إلا لو مكتوب غير كده. "ليه مهم" و"زاوية المحتوى" تفسير آلي. الترجمة: {{ translation_note }}. الدرجة من 100: الصلة 20 · الأثر 20 · الابتكار 15 · مصداقية المصدر 15 · الأدلة 15 · قيمة المحتوى 10 · الإقليمية 5.</footer>
</div></body></html>
