<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
body{margin:0;width:1080px;background:#14110F;color:#FBF8F4;font:26px/1.5 "IBM Plex Sans Arabic",Inter,sans-serif}
.w{padding:60px 64px}
.k{color:#F97316;font-size:22px;font-weight:700}
h1{font-size:58px;line-height:1.2;margin:10px 0 6px;font-weight:700}
.m{color:#A8A29E;font-size:23px}
.st{display:flex;gap:16px;margin:30px 0}
.st div{flex:1;border:1px solid #3F3A35;border-radius:16px;padding:16px 18px}
.st b{display:block;font:700 46px Inter,sans-serif;color:#fff}
.st span{color:#A8A29E;font-size:20px}
.it{display:flex;gap:22px;align-items:flex-start;border-top:1px solid #3F3A35;padding:22px 0}
.n{font:700 46px Inter,sans-serif;color:#F97316;min-width:44px}
.it img{width:190px;height:128px;object-fit:cover;border-radius:12px;background:#2a2622;flex:none}
.h{font-weight:700;font-size:29px;line-height:1.4}
.en{font:19px/1.4 Inter,sans-serif;color:#78716C;direction:ltr;text-align:left;margin-top:4px}
.s{color:#A8A29E;font-size:20px;margin-top:6px}
.lab{display:inline-block;background:#F97316;color:#14110F;font-size:17px;font-weight:700;border-radius:99px;padding:1px 14px;margin-bottom:6px}
.f{margin-top:24px;color:#78716C;font-size:19px}
</style></head><body><div class="w">
<div class="k">Brand Intelligence · النشرة اليومية</div>
<h1>{{ date_long }}</h1>
<div class="m">أهم أخبار البراندنج والتصميم والأعمال</div>
<div class="st">{% for s in stats %}<div><b>{{ s[1] }}</b><span>{{ s[0] }}</span></div>{% endfor %}</div>
{% for n in top %}<div class="it"><div class="n">{{ loop.index }}</div>{% if n.image_url %}<img src="{{ n.image_url }}" onerror="this.style.visibility='hidden'">{% endif %}
<div><div class="lab">{{ n.label }}</div><div class="h">{{ n.headline_ar or n.headline }}</div>{% if n.headline_ar %}<div class="en">{{ n.headline }}</div>{% endif %}<div class="s">{{ n.source_name }} · {{ n.pr }} · {{ n.overall_score }}/100</div></div></div>{% endfor %}
<div class="f">التقرير الكامل بكل اللينكات في ملف الـ PDF المرفق</div>
</div></body></html>
