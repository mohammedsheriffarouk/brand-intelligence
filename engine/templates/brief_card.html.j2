<!DOCTYPE html><html><head><meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap" rel="stylesheet">
<style>
body{margin:0;width:1080px;background:#14110F;color:#FBF8F4;font:26px/1.4 Inter,"IBM Plex Sans Arabic",sans-serif}
.w{padding:60px 64px}
.k{color:#F97316;letter-spacing:.16em;text-transform:uppercase;font-size:20px;font-weight:600}
h1{font-family:Fraunces,Georgia,serif;font-size:62px;line-height:1.05;margin:10px 0 6px}
.m{color:#A8A29E;font-size:22px}
.st{display:flex;gap:16px;margin:30px 0}
.st div{flex:1;border:1px solid #3F3A35;border-radius:16px;padding:16px 18px}
.st b{display:block;font-family:Fraunces,Georgia,serif;font-size:44px;color:#fff}
.st span{color:#A8A29E;font-size:19px}
.it{display:flex;gap:22px;align-items:flex-start;border-top:1px solid #3F3A35;padding:22px 0}
.n{font-family:Fraunces,Georgia,serif;font-size:44px;color:#F97316;min-width:44px}
.it img{width:190px;height:128px;object-fit:cover;border-radius:12px;background:#2a2622;flex:none}
.h{font-weight:600;font-size:28px;line-height:1.25}
.s{color:#A8A29E;font-size:20px;margin-top:6px}
.lab{display:inline-block;background:#F97316;color:#14110F;font-size:16px;font-weight:700;border-radius:99px;padding:2px 12px;margin-bottom:6px}
.f{margin-top:24px;color:#78716C;font-size:18px}
</style></head><body><div class="w">
<div class="k">Brand Intelligence · Daily Brief</div>
<h1>{{ date_long }}</h1>
<div class="m">Top stories for branding, design & business</div>
<div class="st">{% for s in stats %}<div><b>{{ s[1] }}</b><span>{{ s[0] }}</span></div>{% endfor %}</div>
{% for n in top %}<div class="it"><div class="n">{{ loop.index }}</div>{% if n.image_url %}<img src="{{ n.image_url }}" onerror="this.style.visibility='hidden'">{% endif %}
<div><div class="lab">{{ n.label }}</div><div class="h" dir="auto">{{ n.headline }}</div><div class="s">{{ n.source_name }} · {{ n.priority }} · {{ n.overall_score }}/100</div></div></div>{% endfor %}
<div class="f">Full report with all links → {{ link or 'see attached PDF' }}</div>
</div></body></html>
